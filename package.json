{
  "name": "xiao-ui-theme-ts",
  "version": "0.6.0",
  "license": "MIT",
  "type": "module",
  "author": "jinxlux",
  "description": "Customizable theme plugin for DeepSeek Harness web UI. Ships with a Xiao-style jade palette by default; accent color, mascot badge text, injected voice and frosted background are all configurable. Built with TypeScript and pnpm.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "theme",
    "plugin",
    "xiao",
    "ui-theme"
  ],
  "homepage": "https://github.com/jinxlux/xiao-theme-dsh-ui-plugin#readme",
  "bugs": {
    "url": "https://github.com/jinxlux/xiao-theme-dsh-ui-plugin/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jinxlux/xiao-theme-dsh-ui-plugin.git"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "resource",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "build": "node -e \"const fs=require('node:fs');fs.rmSync('lib',{recursive:true,force:true});fs.rmSync('.build',{recursive:true,force:true})\" && tsc -p tsconfig.json && tsc -p tsconfig.build-host.json && tsc -p tsconfig.build-client.json && node scripts/wrap-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "tsc -p tsconfig.json --noEmit && node scripts/check-dsh.mjs",
    "clean": "node -e \"const fs=require('node:fs');fs.rmSync('lib',{recursive:true,force:true});fs.rmSync('.build',{recursive:true,force:true})\"",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.1",
    "js-yaml": "^4.1.0",
    "react": "^18.2.0",
    "typescript": "^5.6.0"
  }
}
